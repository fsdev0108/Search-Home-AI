// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Simplified schema - Sensay manages organizations, users, and replicas
// We only store what we need locally for our integrations

model IntegrationSettings {
  id             String   @id @default(uuid())
  organizationSecret String @unique // X-ORGANIZATION-SECRET from Sensay
  organizationName String
  settings       String   // JSON string for app-specific settings
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  hubspotSettings HubSpotSettings?
  telegramSettings TelegramSettings?
  twilioSettings TwilioSettings?
  syncLogs       SyncLog[]
  users          User[]

  @@map("integration_settings")
}

model User {
  id             String   @id @default(uuid())
  integrationId  String
  sensayUserId   String   @unique // ID from Sensay API
  name           String
  email          String
  password       String   // Hashed password for authentication
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  integration    IntegrationSettings @relation(fields: [integrationId], references: [id])

  @@map("users")
}

// Removed models that are now managed by Sensay API
// - Property: managed by external systems (HubSpot, etc.)
// - DataConnector: replaced by IntegrationSettings
// - UploadSchedule: managed by Sensay
// - FileUpload: managed by Sensay

model HubSpotSettings {
  id             String   @id @default(uuid())
  integrationId  String   @unique
  apiKey         String
  isConnected    Boolean  @default(false)
  lastSync       DateTime?
  propertiesCount Int     @default(0)
  syncStatus     String   @default("idle") // idle, syncing, success, error
  errorMessage   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  integration    IntegrationSettings @relation(fields: [integrationId], references: [id])

  @@map("hubspot_settings")
}

model SyncLog {
  id             String   @id @default(uuid())
  integrationId  String
  replicaId      String?  // Sensay replica ID
  operation      String   // sync, upload, create_user, etc.
  status         String   // success, error, pending
  details        String?  // JSON string with operation details
  errorMessage   String?
  createdAt      DateTime @default(now())

  integration    IntegrationSettings @relation(fields: [integrationId], references: [id])

  @@map("sync_logs")
}

model TelegramSettings {
  id             String   @id @default(uuid())
  integrationId  String   @unique
  botToken       String   // Bot token from @BotFather
  botUsername    String   // Bot username (e.g., @mycompanybot)
  isActive       Boolean  @default(false)
  replicaId      String?  // Connected Sensay replica ID
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  integration    IntegrationSettings @relation(fields: [integrationId], references: [id])

  @@map("telegram_settings")
}

model TwilioSettings {
  id             String   @id @default(uuid())
  integrationId  String   @unique
  accountSid     String   // Twilio Account SID
  authToken      String   // Twilio Auth Token
  phoneNumber    String   // WhatsApp Business number
  isActive       Boolean  @default(false)
  replicaId      String?  // Connected Sensay replica ID
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  integration    IntegrationSettings @relation(fields: [integrationId], references: [id])

  @@map("twilio_settings")
}

