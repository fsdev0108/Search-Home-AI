{
  "name": "sensay",
  "version": "1.0.0",
  "description": "Real Estate AI Agent Bot",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && prisma generate && cp -r src/templates dist/",
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "railway:build": "npm run build",
    "railway:start": "npm run resolve:migration && prisma db push --accept-data-loss && npm start",
    "resolve:migration": "node scripts/resolve-migration.js",
    "railway:fix": "npm run resolve:migration && npm run railway:start",
    "vercel-build": "npm run build",
    "vercel-dev": "npm run dev",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.3.0",
    "@prisma/client": "^6.15.0",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/uuid": "^10.0.0",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.4.7",
    "fastify": "^4.24.3",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.15.0",
    "twilio": "^5.10.0",
    "uuid": "^11.0.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  }
}
